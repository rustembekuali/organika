// Cloudflare Workers арқылы жариялау: сайт — dist/ ішіндегі дайын статикалық файлдар.
// Cloudflare-де Build command: npm run build, Deploy command: npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "organika",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
